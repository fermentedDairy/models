{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama_smart/fd-ornith1.5-35b-bigC",
  "small_model": "ollama_dumb/small-gemma4-e4b",
  "plugins": [
    "/home/edward-cheesman/opencode-v2-lsp-support"
  ],
  "lsp": {
    "kotlin-lsp": {
      "command": [
        "kotlin-lsp",
        "--stdio"
      ],
      "extensions": [
        ".kt",
        ".kts"
      ]
    },
    "jdtls": {
      "command": [
        "jdtls"
      ],
      "extensions": [
        ".java"
      ]
    },
    "bash-ls": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  },
