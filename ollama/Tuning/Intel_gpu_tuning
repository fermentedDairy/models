### Editing /etc/systemd/system/ollama.service.d/override.conf
### Anything between here and the comment below will become the contents of the drop-in file

[Service]
# Exposes over the LAN
Environment="OLLAMA_HOST=0.0.0.0"
Environment="OLLAMA_ORIGINS=*"
#Prevent model unloading (quicker response times if not switching models)
Environment="OLLAMA_KEEP_ALIVE=-1"
#means MoE models don't load the entire sprase matrix
Environment="OLLAMA_FLASH_ATTENTION=1"
#ONly run one request at at time (can maybe increase thanks to larger VRAM)
Environment="OLLAMA_NUM_PARALLEL=1"
# Only load 1 model st a time
Environment="OLLAMA_MAX_LOADED_MODELS=1"
# Intel libs
Environment="LD_LIBRARY_PATH=/opt/intel/oneapi/compiler/latest/lib:/opt/intel/oneapi/mkl/latest/lib:/opt/intel/oneapi/tbb/latest/lib:/opt/intel/oneapi/umf/latest/lib:/usr/local/lib/ollama/sycl"
# Intel device selection
Environment="ONEAPI_DEVICE_SELECTOR=level_zero:0"
#use the intel GPU
Environment="OLLAMA_NUM_GPU=999"
# Use SYCL to talk to the intel GPU
Environment="OLLAMA_LLM_LIBRARY=sycl"
#Don't try to use vulkan
Environment="OLLAMA_VULKAN=0"
#Default context length (overridden by models)
Environment="OLLAMA_CONTEXT_LENGTH=32768"
# Eager execution of GPU kernels 
Environment="GGML_SYCL_DISABLE_GRAPH=1"
# Limit to a single device don't try to look at the integrated graphics (which I don't have)
Environment="UR_L0_DEVICE_SCOPE=1"
# Bypass sysman (intel_gpu_top stops working)
Environment="ZES_ENABLE_SYSMAN=0"
# Use 8 but quantization in the KV cache (Tokens/s boost for larger models)
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
Environment="UR_L0_USE_IMMEDIATE_COMMANDLISTS=1"

