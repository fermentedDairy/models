FROM qwen3.5:9b

# Hardware & VRAM Tuning (Arc Pro B60 22.7 GiB usable + q8_0 KV Cache)
# 9B dense takes ~6 GB, leaving ~16+ GiB free—32768 fits 100% GPU effortlessly
PARAMETER num_ctx 32768
PARAMETER num_batch 1024
PARAMETER num_keep -1

# Agentic Tool-Calling & Code Precision (Replaces creative temperature=1.0 & harsh presence_penalty=1.5)
PARAMETER temperature 0.15
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER min_p 0.05

# Gentle anti-looping without corrupting repeated code tokens
PARAMETER presence_penalty 0.15
PARAMETER repeat_penalty 1.05
PARAMETER repeat_last_n 256

SYSTEM """You are a fast, precise software engineering agent operating inside a terminal harness.
- Follow tool-calling JSON schemas strictly and never invent parameters.
- Make minimal, surgical edits rather than rewriting entire files unless requested.
- Keep responses concise and verify changes before concluding.
/no_think"""