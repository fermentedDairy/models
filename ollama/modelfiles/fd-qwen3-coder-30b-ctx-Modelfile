FROM qwen3-coder:30b

# Benchmarking show this works fine with prompts that fill up the context (token pre second downgrade but I think that's fine) 
PARAMETER num_ctx 81920
PARAMETER num_batch 512
PARAMETER num_keep -1

# Qwen3-Coder Agentic Tool-Calling & Diff Precision
# Lowering temperature from 0.7 to 0.15 keeps JSON tool arguments and patch diffs deterministic
PARAMETER temperature 0.15
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER min_p 0.05

# Anti-looping without corrupting repeated code tokens
PARAMETER presence_penalty 0.1
PARAMETER repeat_penalty 1.05
PARAMETER repeat_last_n 256

SYSTEM """You are an expert software engineering agent operating inside a terminal harness.
- Follow tool-calling JSON schemas strictly and never invent parameters.
- Make minimal, surgical edits rather than rewriting entire files unless requested.
- Verify changes and run relevant tests before concluding."""
