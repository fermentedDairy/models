FROM devstral-small-2:24b

# Hardware & Context Tuning (Arc Pro B60 24GB + q8_0 KV Cache)
# 24B Q4_K_M takes ~14.5 GB, leaving ~8 GB free for a full 64K context window
PARAMETER num_ctx 65536
PARAMETER num_batch 1024

# Agentic Tool-Calling & Diff Precision
# Low temperature prevents malformed JSON arguments and broken search/replace diffs
PARAMETER temperature 0.15
PARAMETER top_p 0.95
PARAMETER top_k 40
PARAMETER min_p 0.05

# Prevent endless tool-call loops without breaking code syntax/indentation
PARAMETER repeat_penalty 1.05
PARAMETER repeat_last_n 256