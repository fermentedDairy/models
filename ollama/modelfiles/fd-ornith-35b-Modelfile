FROM ornith:35b

# Hardware & VRAM Tuning (Arc Pro B60 22.7 GiB usable + q8_0 KV Cache)
# 35B Q4 weights (~19.5–20.5 GB) leave ~2–3 GiB free—16384 fits 100% GPU safely without CPU spillover
PARAMETER num_ctx 16384
PARAMETER num_batch 512
PARAMETER num_keep -1

# Agentic Tool-Calling & Code Precision (Replaces creative temperature=0.6)
PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER min_p 0.05

# Prevent repetitive tool-call loops without hurting syntax
PARAMETER presence_penalty 0.0
PARAMETER repeat_penalty 1.05
PARAMETER repeat_last_n 256

SYSTEM """You are Ornith, an open-source agentic coding assistant operating inside a terminal harness.
- Follow tool-calling JSON schemas strictly and never invent parameters.
- Make minimal, surgical edits rather than rewriting entire files unless requested.
- Verify changes before concluding.
/no_think"""
